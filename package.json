{
  "name": "cashory",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "@types/bun": "^1.4.0",
      "better-auth": "1.7.1",
      "@better-auth/expo": "1.7.1"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @cashory/db --",
    "db:studio": "turbo run db:studio -F @cashory/db --",
    "db:generate": "turbo run db:generate -F @cashory/db --",
    "db:migrate": "turbo run db:migrate -F @cashory/db --"
  },
  "dependencies": {
    "@cashory/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cashory/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.12"
}
